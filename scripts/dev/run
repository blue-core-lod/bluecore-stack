#!/usr/bin/env bash
set -euo pipefail
################################################################################
## Bring up the dev stack. Default: build every Blue Core service from the LOCAL
## repo checkouts below, with live-reload source mounts.
##
##   ./scripts/dev/run                 # full local stack (everything)
##   ./scripts/dev/run --image         # GHCR-published images instead
##
## Run a SUBSET (local mode only). postgres, keycloak, nginx and the bluecore
## API (which runs DB migrations on start) are ALWAYS up; pick what else runs:
##
##   ./scripts/dev/run --api           # core + API only (no airflow)
##   ./scripts/dev/run --marva         # core + Marva (+ middleware)
##   ./scripts/dev/run --sinopia       # core + Sinopia
##   ./scripts/dev/run --airflow       # core + Airflow
##   ./scripts/dev/run --marva --sinopia   # combine as needed
##
## No subset flag = everything. Subset flags are ignored in --image mode.
## bluecore-models is mounted into the local API and Airflow services automatically.
################################################################################

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

# ==============================================================================
# ################  LOAD LOCAL REPO PATHS  #####################################
# ==============================================================================
. "$ROOT_DIR/scripts/dev/local-repo-paths"
export AIRFLOW_UID=50000

mode="local"
selected=0  # 1 once any subset flag is seen (so no flag = everything)
profiles=()
for arg in "$@"; do
  case "$arg" in
    --image)   mode="image" ;;
    --api)     selected=1 ;;  # core only
    --marva)   selected=1; profiles+=("marva") ;;
    --sinopia) selected=1; profiles+=("sinopia") ;;
    --airflow) selected=1; profiles+=("airflow") ;;
    -h|--help) sed -n '3,21p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

if [[ "$mode" == "image" ]]; then
  echo "🐳 Image mode: GHCR images via compose-dev.yaml (full stack)"
  docker compose -f compose-dev.yaml pull
  docker compose -f compose-dev.yaml up
  exit $?
fi

# Local mode: select profiles. No subset flag => run everything.
if [[ "$selected" == "0" ]]; then
  export COMPOSE_PROFILES="airflow,sinopia,marva"
else
  export COMPOSE_PROFILES="$(IFS=,; echo "${profiles[*]:-}")"
fi

# Stop if any Blue Core checkout is missing. Otherwise Docker creates empty
# placeholder folders for the mounts and the service fails (e.g.
# dctap-dancer's "npm ci" with no package-lock.json).
is_checkout() {
  # The folder must be the top of its own repo: an uninitialized submodule
  # (nginx/toolbox) is an empty folder inside bluecore-stack's repo.
  [[ -d "$1" ]] && [[ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" == "$(cd "$1" && pwd -P)" ]]
}
missing=()
for repo_dir in \
  "$LOCAL_BLUECORE_API_DIR" "$LOCAL_BLUECORE_MODELS_DIR" "$LOCAL_BLUECORE_WORKFLOWS_DIR" \
  "$LOCAL_SINOPIA_DIR" "$LOCAL_MARVA_DIR" "$LOCAL_DCTAP_DANCER_DIR" "$LOCAL_GRAPH_TOOLBOX_DIR"; do
  is_checkout "$repo_dir" || missing+=("$(basename "$repo_dir")  ($repo_dir)")
done
if [[ "${#missing[@]}" -gt 0 ]]; then
  echo "❌ Missing Blue Core repo(s):" >&2
  printf '   %s\n' "${missing[@]}" >&2
  echo "   Install them with: ./scripts/dev/update-stack --install" >&2
  exit 1
fi

echo "🏗️  Local mode (compose-local-dev.yaml)"
echo "   always: postgres, keycloak, nginx, bc_api"
echo "   profiles: ${COMPOSE_PROFILES:-<none — core only>}"
docker compose -f compose-local-dev.yaml up --build
