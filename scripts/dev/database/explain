#!/usr/bin/env bash
set -euo pipefail
################################################################################
## Follow the query plans Postgres logs for slow queries, in color.
## Needs POSTGRES_EXPLAIN_SLOW_QUERY_MS set in .env (see compose-dev.yaml).
##
##   ./scripts/dev/database/explain              follow new plans
##   ./scripts/dev/database/explain --since 10m  also show the last 10 minutes
##
## Colors:
##   yellow  how long the query took (red when 100 ms or more)
##   cyan    the SQL, magenta its parameters
##   red     full table scans and rows thrown away (usually the slow part)
##   green   index lookups (usually the fast part)
################################################################################

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
CONTAINER="bluecore-stack-postgres-1"

since="0s"
if [[ "${1:-}" == "--since" && -n "${2:-}" ]]; then
  since="$2"
elif [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '3,15p' "${BASH_SOURCE[0]}"
  exit 0
fi

bold="\033[1m"; dim="\033[2m"; red="\033[1;31m"; green="\033[1;32m"; reset="\033[0m"

# The value in .env (the last uncommented line wins, like Docker Compose)
env_value="$(grep -E '^POSTGRES_EXPLAIN_SLOW_QUERY_MS=' "$ROOT_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
# The value the running Postgres is actually using, in milliseconds
server_value="$(docker exec "$CONTAINER" psql -U "${DATABASE_USERNAME:-airflow}" -tAc \
  "SELECT setting FROM pg_settings WHERE name = 'auto_explain.log_min_duration'" 2>/dev/null || true)"
server_value="${server_value:-unknown}"

echo -e "${bold}Postgres slow query plans${reset}"
echo -e "${dim}Shows how Postgres ran each slow query (auto_explain), so you can see"
echo -e "whether it used an index or scanned the whole table.${reset}"
echo
echo -e "  .env  POSTGRES_EXPLAIN_SLOW_QUERY_MS=${env_value:-(not set, so off)}"
echo -e "  Postgres is using:              ${server_value}"
echo
echo -e "${dim}How to turn it on:"
echo -e "  1. In .env set POSTGRES_EXPLAIN_SLOW_QUERY_MS to a number of milliseconds:"
echo -e "       0    logs every query"
echo -e "       200  logs queries slower than 200 ms"
echo -e "       -1   off (the default)"
echo -e "  2. Recreate Postgres so it picks up the change"
echo -e "  3. Run a search (or anything else), and its plan shows up below${reset}"
echo

if [[ "$server_value" == "-1" || "$server_value" == "unknown" ]]; then
  echo -e "${red}Logging is off right now, so nothing will show up until you set POSTGRES_EXPLAIN_SLOW_QUERY_MS in your .env.${reset}"
elif [[ "$server_value" != "${env_value:--1}" && -n "$env_value" ]]; then
  echo -e "${red}.env and Postgres differ: restart Postgres to use the .env value.${reset}"
elif [[ "$server_value" == "0" ]]; then
  echo -e "${green}Logging every query. Waiting for queries (Ctrl+C to stop)...${reset}"
else
  echo -e "${green}Logging queries slower than ${server_value} ms. Waiting for queries (Ctrl+C to stop)...${reset}"
fi

docker logs --follow --since "$since" "$CONTAINER" 2>&1 | awk '
  BEGIN {
    yellow = "\033[1;33m"; cyan = "\033[36m"; magenta = "\033[35m"
    red = "\033[1;31m"; green = "\033[1;32m"; reset = "\033[0m"
  }
  # A plan starts with a "duration: ... plan:" line, then tab-indented lines
  /LOG:  duration: .* plan:/ {
    in_plan = 1
    in_sql = 0
    milliseconds = $0
    sub(/.*duration: /, "", milliseconds)
    print ""
    print (milliseconds + 0 >= 100 ? red : yellow) $0 reset
    fflush()
    next
  }
  in_plan && /^\t/ {
    line = $0
    # The SQL can span several lines; it ends where the parameters or plan start
    if (line ~ /^\tQuery Text:/) in_sql = 1
    else if (line ~ /^\t[A-Z]/) in_sql = 0

    if (in_sql)                                         line = cyan line reset
    else if (line ~ /Query Parameters:/)                line = magenta line reset
    else if (line ~ /Seq Scan|Rows Removed by Filter/)  line = red line reset
    else if (line ~ /Index Scan|Index Only Scan/)       line = green line reset
    print line
    fflush()
    next
  }
  { in_plan = 0 }
'
