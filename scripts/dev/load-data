#!/usr/bin/env bash
#
# load-data — upload a single or archive of JSON-LD documents to the local bluecore stack.
#
# Usage:
#   ./scripts/dev/load-data <url>     upload the given Bibframe JSON-LD URL
#   ./scripts/dev/load-data <file>    upload the given JSON-LD file, zip or tar.gz
#   ./scripts/dev/load-data           prompt to load the default dev dataset
#
# Points the bluecore CLI at the nginx-fronted stack (localhost/api,
# localhost/keycloak) instead of the direct dev server on :3000, so it works
# while `bluecore-stack` is up. The CLI is the published `bluecore-client`
# package, fetched on demand by `uv tool run`, so nothing needs installing
# first. It still runs in the sibling bluecore_api checkout (via `--directory`)
# so that project's .env — which holds the dev credentials — is picked up
# regardless of where you invoke this script.

set -euo pipefail

# Default dev dataset loaded when no URL is supplied (and the user confirms).
DEFAULT_DEV_DATA_URL="https://raw.githubusercontent.com/blue-core-lod/bluecore_api/refs/heads/main/sample/batch.jsonld"

if [ "$#" -gt 1 ]; then
  echo "Usage: $(basename "$0") [url|file]" >&2
  exit 1
fi

if [ "$#" -eq 1 ]; then
  input="$1"
else
  # No input given — offer to load the default dev data.
  echo "No URL or file provided. Default dev data:" >&2
  echo "  $DEFAULT_DEV_DATA_URL" >&2
  read -r -p "Load the default dev data? [Y/n] " reply
  case "${reply:-Y}" in
    [Yy]*) input="$DEFAULT_DEV_DATA_URL" ;;
    *) echo "Aborted." >&2; exit 0 ;;
  esac
fi

# Decide which bluecore subcommand to use: `load file` for a local file,
# `load url` otherwise.
if [ -f "$input" ]; then
  subcommand=(load file)
  # Resolve to an absolute path so it's valid after `uv tool run --directory`.
  input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
else
  subcommand=(load url)
fi

# This script lives in bluecore-stack/scripts/dev. The bluecore_api checkout,
# whose .env supplies the dev credentials, is configured by
# scripts/dev/local-repo-paths.
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
. "$ROOT_DIR/scripts/dev/local-repo-paths"
api_project="${BLUECORE_API_DIR:-$LOCAL_BLUECORE_API_DIR}"

if [ ! -d "$api_project" ]; then
  echo "bluecore_api project not found at: $api_project" >&2
  echo "Set LOCAL_BLUECORE_API_DIR or BLUECORE_API_DIR to its location and re-run." >&2
  exit 1
fi

# Host the stack is served on; override with BLUECORE_STACK_URL if not localhost.
host="${BLUECORE_STACK_URL:-http://localhost}"
host="${host%/}"

uv tool run --directory "$api_project" --from bluecore-client bluecore --verbose \
  --bluecore-url "$host" \
  --api-url "$host/api" \
  --keycloak-url "$host/keycloak" \
  "${subcommand[@]}" "$input"
